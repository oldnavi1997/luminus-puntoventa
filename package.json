{
  "name": "luminus-puntoventa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:schema": "node -e \"require('fs').copyFileSync(require('path').resolve('..','luminus','prisma','schema.prisma'),'prisma/schema.prisma')\"",
    "verify:schema": "node scripts/verify-schema.js",
    "predev": "npm run sync:schema && prisma generate",
    "dev": "next dev --turbopack",
    "prebuild": "npm run verify:schema && prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "sunat:cert": "tsx --env-file=.env.local scripts/diagnostico-certificado.ts",
    "sunat:b64": "tsx --env-file=.env.local scripts/certificado-base64.ts",
    "sunat:enviar": "tsx --env-file=.env.local scripts/enviar-prueba.ts",
    "sunat:baja": "tsx --env-file=.env.local scripts/generar-baja.ts",
    "sunat:serie": "tsx --env-file=.env.sunat-prod scripts/consultar-serie.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@types/pg": "^8.18.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "mercadopago": "^2.12.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "node-forge": "^1.4.0",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-to-print": "^3.0.5",
    "resend": "^6.9.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "xml-crypto": "^6.1.2",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "xlsx": "^0.18.5"
  }
}
