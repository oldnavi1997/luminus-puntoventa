# Base de datos (misma instancia que Luminus ecommerce)
DATABASE_URL=postgresql://postgres:password@localhost:5433/luminus

# NextAuth — DEBE ser diferente al secret de Luminus
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=genera-un-secret-unico-con-openssl-rand-base64-32

# Nubefact OSE (emisor SUNAT)
NUBEFACT_TOKEN=tu-token-nubefact
NUBEFACT_RUC=20123456789
NUBEFACT_ENV=sandbox   # → "production" en producción

# Lookups DNI/RUC (opcional Fase 2)
APISPERU_TOKEN=

# Store URL para links en recibos
NEXT_PUBLIC_STORE_URL=https://luminus.pe
