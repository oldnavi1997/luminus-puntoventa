# Base de datos (misma instancia que Luminus ecommerce)
DATABASE_URL=postgresql://postgres:password@localhost:5433/luminus

# NextAuth — DEBE ser diferente al secret de Luminus
NEXTAUTH_URL=http://localhost:3003
NEXTAUTH_SECRET=genera-un-secret-unico-con-openssl-rand-base64-32

# ─────────────────────────────────────────────────────────────────────────────
# SUNAT — SEE Del Contribuyente (emisión propia, sin OSE)
# ─────────────────────────────────────────────────────────────────────────────

# Datos del emisor
SUNAT_RUC=20609242753
SUNAT_RAZON_SOCIAL=LUMINUS S.A.C.
SUNAT_NOMBRE_COMERCIAL=Luminus

# Domicilio fiscal. El código de establecimiento lo asigna SUNAT al comunicar
# el local; "0000" corresponde al domicilio fiscal.
SUNAT_COD_ESTABLECIMIENTO=0000
SUNAT_DIRECCION=
SUNAT_UBIGEO=
SUNAT_DEPARTAMENTO=LIMA
SUNAT_PROVINCIA=LIMA
SUNAT_DISTRITO=
SUNAT_PAIS=PE

# Ambiente: "beta" para pruebas y homologación, "produccion" cuando SUNAT lo habilite.
SUNAT_ENV=beta

# Usuario SOL. Va el nombre a secas, SIN el RUC delante: el RUC se antepone
# solo al armar el sobre WSSE (RUC + usuario).
#
# Sirve el usuario principal. Un usuario secundario limitado a facturación
# electrónica es preferible por seguridad —el principal puede declarar, pagar y
# cambiar datos del RUC— pero no es un requisito para emitir.
#
# En beta, SUNAT acepta MODDATOS / moddatos.
SUNAT_SOL_USER=
SUNAT_SOL_PASSWORD=

# Certificado digital (.pfx o .p12 — es el mismo contenedor PKCS#12).
#
# En Railway el filesystem es efímero: no hay dónde dejar el archivo, así que
# va en base64 dentro de la variable. Generarlo con:
#     base64 -w0 certificado.pfx        (Linux)
#     certutil -encode certificado.pfx salida.txt   (Windows)
SUNAT_CERTIFICATE_B64=
SUNAT_CERTIFICATE_PASSWORD=

# Sólo para desarrollo local: alternativa a la variable en base64.
# El archivo NO debe estar dentro del repositorio (ver .gitignore).
SUNAT_CERTIFICATE_PATH=

# Verifica que el certificado abre, está vigente y su RUC coincide:
#     npm run sunat:cert
#
# Genera el base64 para pegarlo en Railway (lo escribe en un archivo ignorado,
# no lo imprime por pantalla):
#     npm run sunat:b64

# Token del cron que drena la cola de comprobantes pendientes.
# Sin él, /api/queue/process sólo acepta sesión de ADMIN y ningún cron puede
# invocarlo — que es por lo que la cola nunca llegaba a drenarse.
QUEUE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Servicios auxiliares
# ─────────────────────────────────────────────────────────────────────────────

# Consulta de DNI/RUC para autocompletar al comprador (no emite comprobantes)
APISUNAT_TOKEN=
APISUNAT_BASE_URL=

# Store URL para links en recibos
NEXT_PUBLIC_STORE_URL=https://luminus.pe
